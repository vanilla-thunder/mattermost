# Vibemost deployment settings. Copy to .env (ignored by git) and fill in.
# Read by the container (docker compose) and by the webpack dev server (npm run dev-server).

# Mattermost server Vibemost talks to: its SiteURL, without a path. Required.
VIBEMOST_MATTERMOST_URL=https://chat.example.com

# Nextcloud server for the sidebar calendar, reached through the same-origin proxy so it
# needs no CORS setup. Optional; calendar links to other servers need CORS on that server.
VIBEMOST_NEXTCLOUD_URL=https://cloud.example.com

# Jitsi servers whose meeting links get a join button: comma-separated host names. Optional.
VIBEMOST_JITSI_HOSTS=meet.example.com

# Container only: host port to publish, and the largest upload accepted (keep it at or above
# Mattermost's MaxFileSize).
VIBEMOST_HTTP_PORT=8080
VIBEMOST_MAX_BODY_SIZE=100m
