# Vibemost: the Vibemost web client in front of an existing Mattermost server.
#
#   /                      -> the built web client
#   /api, /plugins, ...    -> the Mattermost server (VIBEMOST_MATTERMOST_URL)
#   /vibemost-nextcloud    -> Nextcloud public calendars (VIBEMOST_NEXTCLOUD_URL, optional)
#   /vibemost/config.json  -> runtime settings for the client
#
# Rendered at container start by docker-entrypoint.d/40-vibemost.sh. ${NAME} placeholders
# are filled in from the environment; $name are nginx variables. TLS is expected to end at
# a reverse proxy in front of this container.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Keep the scheme the TLS proxy in front reports. Mattermost marks session cookies
# Secure only for https requests.
map $http_x_forwarded_proto $vibemost_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80 default_server;
    server_name _;

    root /usr/share/nginx/vibemost;

    # File uploads go through this host. Keep this at or above Mattermost's MaxFileSize.
    client_max_body_size ${VIBEMOST_MAX_BODY_SIZE};

    # Look up upstream host names per request, not once at start-up, so the container
    # starts even while Mattermost or Nextcloud is unreachable, and follows DNS changes.
    resolver ${VIBEMOST_RESOLVER} valid=30s;
    set $mattermost_upstream ${MATTERMOST_ORIGIN};

    # ---- Mattermost server ------------------------------------------------------
    # Used by every location below that proxies to Mattermost. nginx only inherits
    # these into locations that set no proxy_set_header of their own.
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name ${MATTERMOST_SNI};
    proxy_set_header Host ${MATTERMOST_HOST};
    # The Mattermost server only accepts WebSocket connections whose Origin matches its
    # SiteURL. A name-based reverse proxy in front of it answers 421 for a foreign Host.
    proxy_set_header Origin ${MATTERMOST_ORIGIN};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $vibemost_forwarded_proto;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Keep session cookies on this host, even with AllowCookiesForSubdomains enabled.
    proxy_cookie_domain ${MATTERMOST_SNI} $host;
    proxy_redirect ${MATTERMOST_ORIGIN}/ /;
    proxy_read_timeout 600s;
    proxy_buffering off;

    location /api/ {
        proxy_pass $mattermost_upstream;
    }

    location /plugins/ {
        proxy_pass $mattermost_upstream;
    }

    # Plugin web bundles live on the Mattermost server, not in this build.
    location /static/plugins/ {
        proxy_pass $mattermost_upstream;
    }

    # Server routes outside /api that the web client links to.
    location /login/one_time_link {
        proxy_pass $mattermost_upstream;
    }

    location = /unsupported_browser.js {
        proxy_pass $mattermost_upstream;
    }

    # ---- Vibemost ---------------------------------------------------------------------
    location = /vibemost/config.json {
        alias /usr/share/nginx/vibemost-runtime/config.json;
        default_type application/json;
        add_header Cache-Control "no-cache";
    }

    # The Nextcloud proxy, if VIBEMOST_NEXTCLOUD_URL is set. Anything else is refused.
    include /etc/nginx/vibemost/nextcloud.conf;

    location /vibemost-nextcloud/ {
        return 404;
    }

    # ---- Web client ----------------------------------------------------------------
    # Hashed bundles never change under the same name.
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /static/root.html {
        add_header Cache-Control "no-cache";
    }

    location = /static/manifest.json {
        add_header Cache-Control "no-cache";
    }

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Every other path is a client-side route.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options SAMEORIGIN;
        add_header Content-Security-Policy "frame-ancestors 'self'";
        try_files /static/root.html =404;
    }
}
